        "test:e2e:debug": "playwright test --debug"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.69.2",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "svelte": "^5.56.4",
        "svelte-check": "^4.7.2",
        "typescript": "^6.0.3",
        "vite": "^8.1.4"
    },
    "type": "module"
}
